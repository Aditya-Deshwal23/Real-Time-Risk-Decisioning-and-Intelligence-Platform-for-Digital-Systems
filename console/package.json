{
    "name": "verdict-console",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "packageManager": "npm@11.20.0",
    "engines": {
        "node": "26.13.0"
    },
    "scripts": {
        "dev": "vite",
        "build": "tsc --noEmit && vite build",
