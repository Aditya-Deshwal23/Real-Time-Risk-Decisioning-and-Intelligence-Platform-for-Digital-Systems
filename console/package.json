        "lucide-react": "1.72.0",
        "react": "19.3.1",
        "react-dom": "19.3.1",
        "tailwindcss": "4.3.5"
    },
    "devDependencies": {
        "@eslint/js": "9.39.5",
        "@testing-library/dom": "10.4.2",
        "@testing-library/react": "16.3.3",
        "@types/react": "19.3.0",
        "@types/react-dom": "19.3.0",
        "@vitejs/plugin-react": "6.3.0",
        "eslint": "9.39.5",
        "eslint-plugin-jsx-a11y": "6.10.2",
        "eslint-plugin-react-hooks": "7.1.1",
        "jsdom": "31.0.1",
        "prettier": "3.10.1",
        "typescript": "6.0.3",
        "typescript-eslint": "8.73.0",
        "vite": "8.3.8",
