{
    "name": "verdict-console",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "packageManager": "npm@11.20.0",
    "engines": {
        "node": "26.13.0"
    },
    "scripts": {
        "dev": "vite",
        "build": "tsc --noEmit && vite build",
        "lint": "eslint src --max-warnings 0",
        "format:check": "prettier --check .",
        "typecheck": "tsc --noEmit",
        "test": "vitest run",
        "storybook": "storybook dev -p 6006",
        "storybook:build": "storybook build -c .storybook -o storybook-static"
    },
    "dependencies": {
        "@fontsource/ibm-plex-mono": "5.3.0",
        "@fontsource/ibm-plex-sans": "5.3.0",
        "@radix-ui/react-alert-dialog": "1.2.1",
        "@radix-ui/react-checkbox": "1.4.1",
        "@radix-ui/react-dialog": "1.3.1",
        "@radix-ui/react-select": "2.4.1",
        "@radix-ui/react-switch": "1.4.1",
        "@radix-ui/react-tabs": "1.2.1",
        "@radix-ui/react-toast": "1.3.1",
        "@radix-ui/react-tooltip": "1.4.1",
        "@tailwindcss/vite": "4.3.5",
        "@tanstack/react-table": "9.3.1",
        "@testing-library/user-event": "14.6.13",
        "lucide-react": "1.72.0",
        "react": "19.3.1",
        "react-dom": "19.3.1",
        "react-hook-form": "7.92.0",
        "tailwindcss": "4.3.5",
        "zod": "4.6.7"
    },
    "devDependencies": {
        "@eslint/js": "9.39.5",
        "@storybook/addon-docs": "10.6.8",
        "@storybook/react-vite": "10.6.8",
        "@testing-library/dom": "10.4.2",
        "@testing-library/react": "16.3.3",
        "@types/react": "19.3.0",
        "@types/react-dom": "19.3.0",
        "@vitejs/plugin-react": "6.3.0",
        "eslint": "9.39.5",
        "eslint-plugin-jsx-a11y": "6.10.2",
        "eslint-plugin-react-hooks": "7.1.1",
        "jsdom": "31.0.1",
        "prettier": "3.10.1",
        "storybook": "10.6.8",
        "typescript": "6.0.3",
        "typescript-eslint": "8.73.0",
        "vite": "8.3.8",
        "vitest": "5.1.1"
    }
