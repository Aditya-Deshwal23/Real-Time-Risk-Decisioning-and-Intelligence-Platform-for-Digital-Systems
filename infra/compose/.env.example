TZ=UTC

# Exact official image tags
POSTGRES_IMAGE=postgres:17.12
REDIS_IMAGE=redis:8.10.3

# PostgreSQL local-only values
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=generate-on-first-run
POSTGRES_PORT=5432
VERDICT_DB=verdict
VERDICT_OWNER_PASSWORD=generate-on-first-run
VERDICT_APP_PASSWORD=generate-on-first-run
VERDICT_WORKER_PASSWORD=generate-on-first-run
KEYCLOAK_DB=keycloak
KEYCLOAK_PASSWORD=generate-on-first-run

# Redis local-only values
REDIS_PORT=6379
REDIS_PASSWORD=generate-on-first-run
REDIS_MAXMEMORY=256mb

# First-guess memory limits
POSTGRES_MAX_MEMORY=1g
REDIS_MAX_MEMORY=256m

# Kafka local-only settings
KAFKA_IMAGE=apache/kafka:4.1.2
KAFKA_HOST_PORT=29092
KAFKA_CLUSTER_ID=MkU3OEVBNTcwNTJENDM2Qk
KAFKA_MAX_MEMORY=768m
KAFKA_HEAP_OPTS="-Xms512m -Xmx512m"

# MinIO local-only settings
MINIO_IMAGE_SOURCE=https://github.com/minio/minio.git#RELEASE.2025-10-15T17-29-55Z
MINIO_MC_SOURCE=https://github.com/minio/mc.git#RELEASE.2025-08-13T08-35-41Z
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=generate-on-first-run
MINIO_ROOT_PASSWORD=generate-on-first-run
MINIO_MAX_MEMORY=512m

# Development script timeout
START_TIMEOUT=120
